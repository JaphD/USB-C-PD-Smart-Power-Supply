(version 1)

(rule "U4 intrinsic pad clearance"
    (condition "A.memberOfFootprint('U4') && B.memberOfFootprint('U4')")
    (constraint clearance (min 0.15mm))
)

(rule "U4 VBUS EFUSE escape"
    (condition "A.intersectsCourtyard('U4') && B.intersectsCourtyard('U4') && (((A.NetName == '/VBUS_PD') && (B.NetName == '/EFUSE_OUT')) || ((A.NetName == '/EFUSE_OUT') && (B.NetName == '/VBUS_PD')))")
    (constraint clearance (min 0.15mm))
)

(rule "USB1 intrinsic pad clearance"
    (condition "A.memberOfFootprint('USB1') && B.memberOfFootprint('USB1')")
    (constraint clearance (min 0.15mm))
)
(rule "USB1 intrinsic hole clearance"
    (condition "A.memberOfFootprint('USB1') && B.memberOfFootprint('USB1')")
    (constraint hole_clearance (min 0.15mm))
)